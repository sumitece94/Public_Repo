# MAAS Lab Configuration
# Copy this file to maas-lab.env and customize for your own lab.
# Never commit the real maas-lab.env file.

export MAAS_PROFILE="admin"
export MAAS_URL="http://192.168.10.50:5240/MAAS"

# Example credentials only - replace locally.
export MAAS_USERNAME="<MAAS_USERNAME>"
export MAAS_PASSWORD="<MAAS_PASSWORD>"

export MAAS_OS="ubuntu"
export MAAS_SERIES="jammy"

# Example PXE / provisioning network
export MAAS_PXE_SUBNET="192.168.20.0/24"
export MAAS_GATEWAY="192.168.20.1"
export MAAS_DNS="192.168.20.10"
