# Sanitized OpenVPN server configuration example.
port {{ openvpn_port }}
proto {{ openvpn_protocol }}
dev tun
topology subnet
server {{ vpn_network }} {{ vpn_netmask }}
push "dhcp-option DNS {{ vpn_dns_servers[0] }}"
push "dhcp-option DNS {{ vpn_dns_servers[1] }}"
keepalive 10 120
user nobody
group nogroup
persist-key
persist-tun
ca /etc/openvpn/server/ca.crt
cert /etc/openvpn/server/server.crt
key /etc/openvpn/server/server.key
dh /etc/openvpn/server/dh.pem
auth SHA256
cipher AES-256-GCM
status /var/log/openvpn/status.log
verb 3
